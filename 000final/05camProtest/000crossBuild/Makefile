####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/ui/src/apps || mkdir -p $(INSTALL_ROOT)/opt/ui/src/apps
	-$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/ui/src/apps/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/ui/src/apps/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/ui/src/apps/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/ui/src/apps/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:


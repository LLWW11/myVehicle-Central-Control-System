	$(COPY_FILE) --parents ../camrecorder/main.cpp ../camrecorder/src/cameracontroller.cpp ../camrecorder/src/camera/cameracapture.cpp ../camrecorder/src/camera/framestore.cpp ../camrecorder/src/camera/previewimageprovider.cpp ../camrecorder/src/recorder/avirecorderworker.cpp ../camrecorder/src/recorder/aviwriter.cpp ../../../client/systemuicommonapiclient.cpp $(DISTDIR)/
